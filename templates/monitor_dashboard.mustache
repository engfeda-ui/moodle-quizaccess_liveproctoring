{{!
    Live Monitor Dashboard Template — Zoom Exam Hall
    @template quizaccess_liveproctoring/monitor_dashboard
}}
<div class="lp-monitor-wrap" id="lp-hall-root" dir="ltr">

    <!-- Zoom Exam Hall Header Bar -->
    <div class="lp-monitor-header">
        <div class="lp-monitor-title">
            <span class="lp-live-badge">● LIVE MEETING</span>
            🎥 {{#str}}examhall, quizaccess_liveproctoring{{/str}}
            <span class="lp-quiz-name">— {{{quizname}}}</span>
        </div>
        <div class="lp-header-actions" style="display:flex;align-items:center;gap:10px;">
            {{#groupmenu}}
                <div class="lp-group-selector">{{{groupmenu}}}</div>
            {{/groupmenu}}
            <button id="lp-btn-fullscreen" class="btn btn-sm btn-outline-info" title="{{#str}}fullscreen, quizaccess_liveproctoring{{/str}}">
                ⛶ {{#str}}fullscreen, quizaccess_liveproctoring{{/str}}
            </button>
            <a href="{{{reporturl}}}" class="btn btn-sm btn-outline-secondary" target="_blank">
                📋 {{#str}}viewreport, quizaccess_liveproctoring{{/str}}
            </a>
        </div>
    </div>

    <!-- Alert Banner (hidden by default) -->
    <div class="lp-alert-banner" id="lp-alert-banner" style="display:none"></div>

    <!-- Student Meeting Gallery Grid -->
    <div class="lp-student-grid" id="lp-student-grid">
        <div class="lp-connecting">
            <div class="lp-spinner"></div>
            {{#str}}connecting, quizaccess_liveproctoring{{/str}}
        </div>
    </div>

    <!-- Floating Zoom Meeting Bottom Dock -->
    <div class="lp-meeting-dock">
        <div class="lp-dock-item">
            <span class="lp-dock-icon">👥</span>
            <span class="lp-dock-label">{{#str}}activestudents, quizaccess_liveproctoring{{/str}}:</span>
            <span class="lp-dock-value" id="lp-stat-total">0</span>
        </div>

        <div class="lp-dock-divider"></div>

        <div class="lp-dock-item">
            <span class="lp-dock-icon">🚨</span>
            <span class="lp-dock-label">{{#str}}suspicious, quizaccess_liveproctoring{{/str}}:</span>
            <span class="lp-dock-value lp-risk-high" id="lp-stat-suspicious">0</span>
        </div>

        <div class="lp-dock-divider"></div>

        <!-- Filter Buttons -->
        <div class="lp-dock-filters">
            <button id="lp-filter-all" class="lp-dock-btn active">
                {{#str}}filter_all, quizaccess_liveproctoring{{/str}}
            </button>
            <button id="lp-filter-flagged" class="lp-dock-btn">
                🚨 {{#str}}filter_flagged, quizaccess_liveproctoring{{/str}}
            </button>
        </div>

        <div class="lp-dock-divider"></div>

        <!-- Audio Alert Toggle -->
        <button id="lp-btn-audio" class="lp-dock-btn" title="{{#str}}sound_toggle, quizaccess_liveproctoring{{/str}}">
            🔔 <span id="lp-audio-status">الصوت: مفعّل</span>
        </button>

        <div class="lp-dock-divider"></div>

        <div class="lp-dock-item">
            <span class="lp-dock-label">{{#str}}lastupdate, quizaccess_liveproctoring{{/str}}:</span>
            <span class="lp-dock-time" id="lp-stat-lastupdate">—</span>
        </div>
    </div>

    <!-- Spotlight Theatre Modal (On-Demand Live Stream) -->
    <div id="lp-spotlight-modal" class="lp-spotlight-modal" style="display:none;">
        <div class="lp-spotlight-dialog">
            <div class="lp-spotlight-header">
                <div class="lp-spotlight-title">
                    <span class="lp-live-dot">●</span>
                    <span id="lp-spotlight-name">—</span>
                </div>
                <button id="lp-spotlight-close" class="lp-spotlight-close-btn" title="Close">✕</button>
            </div>

            <div class="lp-spotlight-viewport" style="position:relative;">
                <video id="lp-spotlight-video" autoplay playsinline></video>
                <img id="lp-spotlight-frame" alt="Live Frame" style="display:none;" />
                <div id="lp-spotlight-status" class="lp-spotlight-badge">
                    📡 {{#str}}connecting_live, quizaccess_liveproctoring{{/str}}
                </div>
                <!-- Live Audio Controls in Spotlight -->
                <div class="lp-audio-strip" style="position:absolute;bottom:10px;left:10px;right:10px;display:flex;align-items:center;justify-content:space-between;background:rgba(15,23,42,0.85);backdrop-filter:blur(4px);padding:6px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.1);">
                    <div style="display:flex;align-items:center;gap:8px;">
                        <button id="lp-spotlight-audio-toggle" class="btn btn-sm btn-outline-success" style="font-size:12px;font-weight:bold;">
                            🔊 <span id="lp-audio-btn-label">{{#str}}audiounmuted, quizaccess_liveproctoring{{/str}}</span>
                        </button>
                        <button id="lp-spotlight-record-clip" class="btn btn-sm btn-outline-danger" style="font-size:12px;font-weight:bold;display:flex;align-items:center;gap:4px;">
                            <span id="lp-record-icon">🔴</span>
                            <span id="lp-record-btn-label">{{#str}}record_clip, quizaccess_liveproctoring{{/str}}</span>
                            <span id="lp-record-timer" style="display:none;font-family:monospace;background:rgba(239,68,68,0.25);padding:1px 5px;border-radius:4px;margin-left:4px;">00:00</span>
                        </button>
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;">
                        <span style="font-size:11px;color:#94a3b8;">{{#str}}studentaudio, quizaccess_liveproctoring{{/str}}:</span>
                        <div style="width:100px;height:8px;background:#334155;border-radius:4px;overflow:hidden;position:relative;">
                            <div id="lp-audio-vu-bar" style="width:0%;height:100%;background:#10b981;transition:width 0.1s ease;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Spotlight Proctor Controls -->
            <div class="lp-spotlight-controls">
                <div class="lp-warning-box">
                    <input type="text" id="lp-direct-warning-input" class="lp-warning-input"
                           placeholder="{{#str}}warning_placeholder, quizaccess_liveproctoring{{/str}}" />
                    <button id="lp-btn-send-warning" class="lp-btn-action lp-btn-warning">
                        📢 {{#str}}send_warning, quizaccess_liveproctoring{{/str}}
                    </button>
                </div>

                <div class="lp-terminate-box">
                    <button id="lp-btn-terminate" class="lp-btn-action lp-btn-danger">
                        🚪 {{#str}}terminate_btn, quizaccess_liveproctoring{{/str}}
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>
